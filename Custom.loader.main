-- Tab Switching Engine
local pages = {}
local tabButtons = {}

local function createPage(name)
    local page = Instance.new("Frame")
    page.Name = name .. "Page"
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.Parent = pagesContainer
    pages[name] = page
    return page
end

local pageUnlocker = createPage("Unlocker")
local pageSpoofer = createPage("Spoofer")
local pageSettings = createPage("Settings")
pageUnlocker.Visible = true

local tabNames = {"Unlocker", "Spoofer", "Settings"}
local tabWidth = 1 / #tabNames

for idx, tName in ipairs(tabNames) do
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(tabWidth, -4, 1, -6)
    btn.Position = UDim2.new((idx - 1) * tabWidth, 2, 0, 3)
    btn.BackgroundColor3 = (tName == "Unlocker") and Color3.fromRGB(157, 78, 223) or Color3.fromRGB(22, 22, 30)
    btn.BorderSizePixel = 0
    btn.Text = tName
    btn.TextColor3 = (tName == "Unlocker") and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 160, 180)
    btn.TextSize = 11
    btn.Font = currentFont
    btn.Parent = tabBar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    btn.MouseButton1Click:Connect(function()
        for pName, pFrame in pairs(pages) do
            pFrame.Visible = (pName == tName)
        end
        for btnName, tBtn in pairs(tabButtons) do
            local isSel = (btnName == tName)
            tBtn.BackgroundColor3 = isSel and Color3.fromRGB(157, 78, 223) or Color3.fromRGB(22, 22, 30)
            tBtn.TextColor3 = isSel and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 160, 180)
        end
    end)
    tabButtons[tName] = btn
end

-- Font Switcher Function
applyFontFunc = function(fontEnum)
    currentFont = fontEnum
    title.Font = fontEnum
    mobileBtn.Font = fontEnum
    for _, desc in ipairs(main:GetDescendants()) do
        if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
            desc.Font = fontEnum
        end
    end
end

