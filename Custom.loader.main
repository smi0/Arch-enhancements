local draggingMobile = false
local dragInputMobile, dragStartMobile, startPosMobile

mobileBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingMobile = true
        dragStartMobile = input.Position
        startPosMobile = mobileBtn.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                draggingMobile = false
            end
        end)
    end
end)

mobileBtn.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInputMobile = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInputMobile and draggingMobile then
        local delta = input.Position - dragStartMobile
        mobileBtn.Position = UDim2.new(
            startPosMobile.X.Scale, startPosMobile.X.Offset + delta.X,
            startPosMobile.Y.Scale, startPosMobile.Y.Offset + delta.Y
        )
    end
end)

mobileBtn.MouseButton1Click:Connect(function()
    main.Visible = not main.Visible
end)

