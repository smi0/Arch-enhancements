local function makeSpoofRow(yPos, labelText, placeholder, key)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -6, 0, 58)
    row.Position = UDim2.new(0, 0, 0, yPos)
    row.BackgroundColor3 = Color3.fromRGB(16, 16, 23)
    row.BorderSizePixel = 0
    row.Parent = spoofScroll
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)
    local rs = Instance.new("UIStroke", row)
    rs.Color = Color3.fromRGB(30, 28, 40)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -60, 0, 18)
    lbl.Position = UDim2.new(0, 10, 0, 6)
    lbl.BackgroundTransparency = 1
    lbl.Text = labelText
    lbl.TextColor3 = Color3.fromRGB(170, 170, 190)
    lbl.TextSize = 10
    lbl.Font = currentFont
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = row

    local toggle = Instance.new("TextButton")
    toggle.Size = UDim2.new(0, 42, 0, 18)
    toggle.Position = UDim2.new(1, -50, 0, 6)
    toggle.BackgroundColor3 = Color3.fromRGB(34, 34, 46)
    toggle.BorderSizePixel = 0
    toggle.Text = "OFF"
    toggle.TextColor3 = Color3.fromRGB(140, 140, 160)
    toggle.TextSize = 9
    toggle.Font = currentFont
    toggle.Parent = row
    Instance.new("UICorner", toggle).CornerRadius = UDim.new(0, 4)

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -20, 0, 24)
    box.Position = UDim2.new(0, 10, 0, 27)
    box.BackgroundColor3 = Color3.fromRGB(24, 24, 34)
    box.BorderSizePixel = 0
    box.Text = ""
    box.PlaceholderText = placeholder
    box.TextColor3 = Color3.fromRGB(240, 240, 255)
    box.PlaceholderColor3 = Color3.fromRGB(80, 80, 95)
    box.TextSize = 10
    box.Font = currentFont
    box.ClearTextOnFocus = false
    box.Parent = row
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 5)

    box:GetPropertyChangedSignal("Text"):Connect(function()
        if key == "avatar" then
            spoofData.targetUserId = box.Text
            if spoofData.enabled.avatar and applyAvatarSpoofFunc then
                applyAvatarSpoofFunc(box.Text)
            end
        else
            spoofData[key] = box.Text
        end
    end)

    toggle.MouseButton1Click:Connect(function()
        spoofData.enabled[key] = not spoofData.enabled[key]
        toggle.Text = spoofData.enabled[key] and "ON" or "OFF"
        toggle.TextColor3 = spoofData.enabled[key] and Color3.fromRGB(100, 235, 120) or Color3.fromRGB(140, 140, 160)
        toggle.BackgroundColor3 = spoofData.enabled[key] and Color3.fromRGB(30, 75, 40) or Color3.fromRGB(34, 34, 46)

        if key == "avatar" then
            if spoofData.enabled.avatar and applyAvatarSpoofFunc then
                applyAvatarSpoofFunc(box.Text)
            else
                local char = lp.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        pcall(function()
                            local desc = Players:GetHumanoidDescriptionFromUserId(lp.UserId)
                            if desc then hum:ApplyDescription(desc) end
                        end)
                    end
                end
            end
        end
    end)
end

makeSpoofRow(4, "Username Spoof", "enter fake username", "username")
