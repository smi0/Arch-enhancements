-- ============================================================================
-- FULL BULLETPROOF RIVALS SKINCHANGER & UNLOCK ALL ENGINE
-- ============================================================================
task.spawn(function()
    local playerScripts = lp:WaitForChild("PlayerScripts", 15)
    if not playerScripts then return end
    local controllers = playerScripts:WaitForChild("Controllers", 15)
    if not controllers then return end
    local modules = ReplicatedStorage:WaitForChild("Modules", 15)
    if not modules then return end

    local EnumLibrary = require(modules:WaitForChild("EnumLibrary", 15))
    if EnumLibrary then pcall(function() EnumLibrary:WaitForEnumBuilder() end) end

    local CosmeticLibrary = require(modules:WaitForChild("CosmeticLibrary", 15))
    local ItemLibrary = require(modules:WaitForChild("ItemLibrary", 15))
    local DataController = require(controllers:WaitForChild("PlayerDataController", 15))
    local FighterController = nil
    pcall(function() FighterController = require(controllers:WaitForChild("FighterController", 15)) end)

    local function isFinisher(cosmetic)
        if not cosmetic then return false end
        local t = cosmetic.Type
        return t == "Finisher" or t == "Finish" or (t and string.find(t:lower(), "finish"))
    end

    local function isEmote(cosmetic)
        if not cosmetic then return false end
        local t = cosmetic.Type
        return t == "Dance" or t == "Emote"
    end

    local function cloneCosmetic(name, cosmeticType, options)
        if not CosmeticLibrary or not CosmeticLibrary.Cosmetics then return nil end
        local base = CosmeticLibrary.Cosmetics[name]
        if not base then return nil end
        local data = {}
        for key, value in pairs(base) do data[key] = value end
        data.Name = name
        data.Type = data.Type or cosmeticType
        data.Seed = data.Seed or math.random(1, 1000000)
        if EnumLibrary then
            local success, enumId = pcall(EnumLibrary.ToEnum, EnumLibrary, name)
            if success and enumId then data.Enum, data.ObjectID = enumId, data.ObjectID or enumId end
        end
        if options then
            if options.inverted ~= nil then data.Inverted = options.inverted end
            if options.favoritesOnly ~= nil then data.OnlyUseFavorites = options.favoritesOnly end
        end
        return data
    end

    local saveFile = "Rivals-Skinchanger/skins.txt"

    saveConfigFunc = function()
        if not writefile then return end
        pcall(function()
            local config = {equipped = {}, favorites = favorites}
            for weapon, cosmetics in pairs(equipped) do
                config.equipped[weapon] = {}
                for cosmeticType, cosmeticData in pairs(cosmetics) do
                    if cosmeticData and cosmeticData.Name then
                        config.equipped[weapon][cosmeticType] = {
                            name = cosmeticData.Name, seed = cosmeticData.Seed, inverted = cosmeticData.Inverted
                        }
                    end
                end
            end
            if makefolder then makefolder("Rivals-Skinchanger") end
            writefile(saveFile, HttpService:JSONEncode(config))
        end)
    end

    local function loadConfig()
        if not readfile or not isfile or not isfile(saveFile) then return end
        pcall(function()
            local config = HttpService:JSONDecode(readfile(saveFile))
            if config and config.equipped then
                for weapon, cosmetics in pairs(config.equipped) do
                    equipped[weapon] = {}
                    for cosmeticType, cosmeticData in pairs(config.equipped) do
                        local cloned = cloneCosmetic(cosmeticData.name, cosmeticType, {inverted = cosmeticData.inverted})
                        if cloned then cloned.Seed = cosmeticData.seed equipped[weapon][cosmeticType] = cloned end
                    end
                end
            end
            favorites = (config and config.favorites) or {}
        end)
    end

    -- Hook 1: Cosmetic Inventory Ownership
    local origOwnsCosmetic = CosmeticLibrary.OwnsCosmetic
    CosmeticLibrary.OwnsCosmetic = function(self, inventory, name, weapon)
        if not unlockerEnabled then return origOwnsCosmetic(self, inventory, name, weapon) end
        if typeof(name) == "string" and name:find("MISSING_") then return origOwnsCosmetic(self, inventory, name, weapon) end
        if CosmeticLibrary.Cosmetics and CosmeticLibrary.Cosmetics[name] then return true end
        return origOwnsCosmetic(self, inventory, name, weapon)
    end

    -- Hook 2: Player Data Controller Proxy (Populates ALL cosmetics for Locker UI loop)
    local originalGet = DataController.Get
    DataController.Get = function(self, key)
        local data = originalGet(self, key)
        if not unlockerEnabled then return data end
        if key == "CosmeticInventory" then
            local proxy = {}
            if data then for k, v in pairs(data) do proxy[k] = v end end
            if CosmeticLibrary and CosmeticLibrary.Cosmetics then
                for k, _ in pairs(CosmeticLibrary.Cosmetics) do
                    if proxy[k] == nil then proxy[k] = true end
                end
            end
            return setmetatable(proxy, {
                __index = function(t, k)
                    if CosmeticLibrary and CosmeticLibrary.Cosmetics and CosmeticLibrary.Cosmetics[k] then return true end
                    return nil
                end
            })
        end
        if key == "FavoritedCosmetics" then
            local result = data and table.clone(data) or {}
            for weapon, favs in pairs(favorites) do
                result[weapon] = result[weapon] or {}
                for name, isFav in pairs(favs) do
                    if CosmeticLibrary and CosmeticLibrary.Cosmetics and CosmeticLibrary.Cosmetics[name] then
                        result[weapon][name] = isFav
                    end
                end
            end
            return result
        end
        return data
    end

    -- Hook 3: Get Weapon Data Overrides
    local originalGetWeaponData = DataController.GetWeaponData
    DataController.GetWeaponData = function(self, weaponName)
        local data = originalGetWeaponData(self, weaponName)
        if not data or not unlockerEnabled then return data end
        local merged = table.clone(data)
        merged.Name = weaponName
        if equipped[weaponName] then
            for cosmeticType, cosmeticData in pairs(equipped[weaponName]) do
                if cosmeticType ~= "Dances" then merged[cosmeticType] = cosmeticData end
            end
        end
        return merged
    end

    -- Hook 4: Dynamic Namecall Hook for Equip, Favorite & Use Item Remotes
    if hookmetamethod then
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            if not unlockerEnabled then return oldNamecall(self, ...) end
            if getnamecallmethod() ~= "FireServer" then return oldNamecall(self, ...) end

            local rName = self.Name
            local args = {...}

            if rName == "UseItem" then
                local objectID = args[1]
                if FighterController then
                    pcall(function()
                        local fighter = FighterController:GetFighter(player)
                        if fighter and fighter.Items then
                            for _, item in pairs(fighter.Items) do
                                if item:Get("ObjectID") == objectID then lastUsedWeapon = item.Name break end
                            end
                        end
                    end)
                end
            elseif rName == "EquipCosmetic" then
                local weaponName, cosmeticType, cosmeticName, options = args[1], args[2], args[3], args[4] or {}
                local cosmetic = CosmeticLibrary and CosmeticLibrary.Cosmetics and CosmeticLibrary.Cosmetics[cosmeticName]
                
                if cosmetic and (isFinisher(cosmetic) or isEmote(cosmetic)) then
                    if isEmote(cosmetic) then
                        equipped.Dances = equipped.Dances or {}
                        if not cosmeticName or cosmeticName == "None" or cosmeticName == "" then
                            equipped.Dances[cosmeticType] = nil
                        else
                            local cloned = cloneCosmetic(cosmeticName, cosmeticType, {inverted = options and options.IsInverted, favoritesOnly = options and options.OnlyUseFavorites})
                            if cloned then equipped.Dances[cosmeticType] = cloned end
                        end
                    else
                        equipped[weaponName] = equipped[weaponName] or {}
                        if not cosmeticName or cosmeticName == "None" or cosmeticName == "" then
                            equipped[weaponName][cosmeticType] = nil
                            if not next(equipped[weaponName]) then equipped[weaponName] = nil end
                        else
                            local cloned = cloneCosmetic(cosmeticName, cosmeticType, {inverted = options and options.IsInverted, favoritesOnly = options and options.OnlyUseFavorites})
                            if cloned then equipped[weaponName][cosmeticType] = cloned end
                        end
                    end
                    if saveConfigFunc then saveConfigFunc() end
                    return oldNamecall(self, ...)
                end

                -- Standard Weapon Cosmetics (Skins, Charms, Wraps)
                equipped[weaponName] = equipped[weaponName] or {}
                if not cosmeticName or cosmeticName == "None" or cosmeticName == "" then
                    equipped[weaponName][cosmeticType] = nil
                    if not next(equipped[weaponName]) then equipped[weaponName] = nil end
                else
                    local cloned = cloneCosmetic(cosmeticName, cosmeticType, {inverted = options and options.IsInverted, favoritesOnly = options and options.OnlyUseFavorites})
                    if cloned then equipped[weaponName][cosmeticType] = cloned end
                end

                task.defer(function()
                    pcall(function()
                        if DataController and DataController.CurrentData then
                            DataController.CurrentData:Replicate("WeaponInventory")
                        end
                    end)
                    task.wait(0.2)
                    if saveConfigFunc then saveConfigFunc() end
                end)
                return
            elseif rName == "FavoriteCosmetic" then
                local cosmetic = CosmeticLibrary and CosmeticLibrary.Cosmetics and CosmeticLibrary.Cosmetics[args[2]]
                if cosmetic then
                    favorites[args[1]] = favorites[args[1]] or {}
                    favorites[args[1]][args[2]] = args[3] or nil
                    if saveConfigFunc then saveConfigFunc() end
                    task.spawn(function()
                        pcall(function()
                            if DataController and DataController.CurrentData then
                                DataController.CurrentData:Replicate("FavoritedCosmetics")
                            end
                        end)
                    end)
                end
                return
            end

            return oldNamecall(self, ...)
        end)
    end

    -- Hook 5: Client Item Viewmodel Construction Hook
    local clientItemModule = playerScripts:WaitForChild("Modules", 10)
        and playerScripts.Modules:WaitForChild("ClientReplicatedClasses", 10)
        and playerScripts.Modules.ClientReplicatedClasses:WaitForChild("ClientFighter", 10)
        and playerScripts.Modules.ClientReplicatedClasses.ClientFighter:WaitForChild("ClientItem", 10)

    local ClientItem = clientItemModule and require(clientItemModule)

    if ClientItem and ClientItem._CreateViewModel then
        local originalCreateViewModel = ClientItem._CreateViewModel
        ClientItem._CreateViewModel = function(self, viewmodelRef)
            if not unlockerEnabled then return originalCreateViewModel(self, viewmodelRef) end
            local weaponName = self.Name
            local weaponPlayer = self.ClientFighter and self.ClientFighter.Player
            constructingWeapon = (weaponPlayer == player) and weaponName or nil
            if weaponPlayer == player and equipped[weaponName] and viewmodelRef then
                local dataKey, skinKey, charmKey, wrapKey, nameKey = self:ToEnum("Data"), self:ToEnum("Skin"), self:ToEnum("Charm"), self:ToEnum("Wrap"), self:ToEnum("Name")
                local data = viewmodelRef[dataKey] or viewmodelRef.Data
                if data then
                    if equipped[weaponName].Skin then data[skinKey or "Skin"] = equipped[weaponName].Skin end
                    if equipped[weaponName].Charm then data[charmKey or "Charm"] = equipped[weaponName].Charm end
                    if equipped[weaponName].Wrap then data[wrapKey or "Wrap"] = equipped[weaponName].Wrap end
                    if equipped[weaponName].Skin then data[nameKey or "Name"] = equipped[weaponName].Skin.Name end
                end
            end
            local result = originalCreateViewModel(self, viewmodelRef)
            constructingWeapon = nil
            return result
        end
    end

    -- Hook 6, 7 & 8: Client Viewmodel Class Hooks (New, GetCharm, GetWrap)
    local viewModelModule = clientItemModule and clientItemModule:WaitForChild("ClientViewModel", 10)
    if viewModelModule then
        local ClientViewModel = require(viewModelModule)
        if ClientViewModel then
            local originalNew = ClientViewModel.new
            ClientViewModel.new = function(replicatedData, clientItem)
                if not unlockerEnabled then return originalNew(replicatedData, clientItem) end
                local weaponPlayer = clientItem and clientItem.ClientFighter and clientItem.ClientFighter.Player
                local weaponName = constructingWeapon or (clientItem and clientItem.Name)
                if weaponPlayer == player and weaponName and equipped[weaponName] then
                    local ReplicatedClass = require(ReplicatedStorage.Modules.ReplicatedClass)
                    local dataKey = ReplicatedClass:ToEnum("Data")
                    replicatedData[dataKey] = replicatedData[dataKey] or {}
                    local cosmetics = equipped[weaponName]
                    if cosmetics.Skin then replicatedData[dataKey][ReplicatedClass:ToEnum("Skin")] = cosmetics.Skin end
                    if cosmetics.Charm then replicatedData[dataKey][ReplicatedClass:ToEnum("Charm")] = cosmetics.Charm end
                    if cosmetics.Wrap then replicatedData[dataKey][ReplicatedClass:ToEnum("Wrap")] = cosmetics.Wrap end
                end
                local result = originalNew(replicatedData, clientItem)
                if weaponPlayer == player and weaponName and equipped[weaponName] and equipped[weaponName].Wrap and result and result._UpdateWrap then
                    result:_UpdateWrap()
                    task.delay(0.1, function() if not result._destroyed then result:_UpdateWrap() end end)
                end
                return result
            end

            if ClientViewModel.GetCharm then
                local originalGetCharmFunc = ClientViewModel.GetCharm
                ClientViewModel.GetCharm = function(self)
                    if not unlockerEnabled then return originalGetCharmFunc(self) end
                    local weaponName = self.ClientItem and self.ClientItem.Name
                    local weaponPlayer = self.ClientItem and self.ClientItem.ClientFighter and self.ClientItem.ClientFighter.Player
                    if weaponName and weaponPlayer == player and equipped[weaponName] and equipped[weaponName].Charm then
                        return equipped[weaponName].Charm
                    end
                    return originalGetCharmFunc(self)
                end
            end

            if ClientViewModel.GetWrap then
                local originalGetWrapFunc = ClientViewModel.GetWrap
                ClientViewModel.GetWrap = function(self)
                    if not unlockerEnabled then return originalGetWrapFunc(self) end
                    local weaponName = self.ClientItem and self.ClientItem.Name
                    local weaponPlayer = self.ClientItem and self.ClientItem.ClientFighter and self.ClientItem.ClientFighter.Player
                    if weaponName and weaponPlayer == player and equipped[weaponName] and equipped[weaponName].Wrap then
                        return equipped[weaponName].Wrap
                    end
                    return originalGetWrapFunc(self)
                end
            end
        end
    end

    -- Hook 9: Item Library Viewmodel Image Renderer Hook
    if ItemLibrary and ItemLibrary.GetViewModelImageFromWeaponData then
        local originalGetViewModelImage = ItemLibrary.GetViewModelImageFromWeaponData
        ItemLibrary.GetViewModelImageFromWeaponData = function(self, weaponData, highRes)
            if not unlockerEnabled or not weaponData then return originalGetViewModelImage(self, weaponData, highRes) end
            local weaponName = weaponData.Name
            local shouldShowSkin = (weaponData.Skin and equipped[weaponName] and weaponData.Skin == equipped[weaponName].Skin) or (viewingProfile == player and equipped[weaponName] and equipped[weaponName].Skin)
            if shouldShowSkin and equipped[weaponName] and equipped[weaponName].Skin then
                local skinInfo = self.ViewModels and self.ViewModels[equipped[weaponName].Skin.Name]
                if skinInfo then return skinInfo[highRes and "ImageHighResolution" or "Image"] or skinInfo.Image end
            end
            return originalGetViewModelImage(self, weaponData, highRes)
        end
    end

    -- Hook 10: Emote Controller Dance/Emote Hook
    pcall(function()
        local EmoteController = require(controllers:WaitForChild("EmoteController", 10))
        if EmoteController and EmoteController.GetEmotes then
            local originalGetEmotes = EmoteController.GetEmotes
            EmoteController.GetEmotes = function(self)
                local emotes = originalGetEmotes(self)
                if not unlockerEnabled then return emotes end
                if CosmeticLibrary and CosmeticLibrary.Cosmetics then
                    for name, cosmetic in pairs(CosmeticLibrary.Cosmetics) do
                        if cosmetic and (cosmetic.Type == "Dance" or cosmetic.Type == "Emote") then
                            if not emotes[name] then
                                emotes[name] = {
                                    Name = name,
                                    Type = cosmetic.Type,
                                    ObjectID = cosmetic.ObjectID,
                                    Enum = cosmetic.Enum
                                }
                            end
                        end
                    end
                end
                return emotes
            end
        end
    end)

    -- Hook 11: Profile Viewer Hook
    pcall(function()
        local viewProfileModule = playerScripts:WaitForChild("Modules", 10):WaitForChild("Pages", 10):WaitForChild("ViewProfile", 10)
        local ViewProfile = viewProfileModule and require(viewProfileModule)
        if ViewProfile and ViewProfile.Fetch then
            local originalFetch = ViewProfile.Fetch
            ViewProfile.Fetch = function(self, targetPlayer)
                viewingProfile = targetPlayer
                return originalFetch(self, targetPlayer)
            end
        end
    end)

    loadConfig()
end)

-- ============================================================================
-- ULTRA-OPTIMIZED THROTTLED SPOOFER ENGINE (0% CPU FRAME OVERHEAD)
-- ============================================================================
applyAvatarSpoofFunc = function(targetUserId)
    if not spoofData.enabled.avatar or not targetUserId or targetUserId == "" then return end
    local id = tonumber(targetUserId)
    if not id then return end
    local char = lp.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local ok, desc = pcall(function()
        return Players:GetHumanoidDescriptionFromUserId(id)
    end)
    if ok and desc then
        pcall(function() hum:ApplyDescription(desc) end)
    end
end

-- Throttled Polling Engine (Runs every 0.3s instead of 144Hz per-frame recursion)
task.spawn(function()
    while task.wait(0.3) do
        if spoofData.enabled.username or spoofData.enabled.level or spoofData.enabled.displayName then
            pcall(function()
                local char = lp.Character
                if char then
                    for _, desc in ipairs(char:GetDescendants()) do
                        if desc:IsA("BillboardGui") then
                            for _, child in ipairs(desc:GetDescendants()) do
                                if child:IsA("TextLabel") then
                                    local t = child.Text
                                    if spoofData.enabled.username and (t == lp.Name or t == lp.DisplayName) then
                                        child.Text = spoofData.username ~= "" and spoofData.username or t
                                    end
                                    if spoofData.enabled.level and t:match("^%d+$") then
                                        child.Text = spoofData.level ~= "" and spoofData.level or t
                                    end
                                    if spoofData.enabled.level and t:match("[Ll]evel") then
                                        child.Text = t:gsub("%d+", spoofData.level ~= "" and spoofData.level or "%0")
                                    end
                                end
                            end
                        end
                    end
                end
                local pg = lp:FindFirstChild("PlayerGui")
                if pg then
                    for _, desc in ipairs(pg:GetDescendants()) do
                        if desc:IsA("TextLabel") then
                            local t = desc.Text
                            if spoofData.enabled.username and (t == lp.Name or t == lp.DisplayName) then
                                desc.Text = spoofData.username ~= "" and spoofData.username or t
                            end
                            if spoofData.enabled.displayName and t == lp.DisplayName then
                                desc.Text = spoofData.displayName ~= "" and spoofData.displayName or t
                            end
                            if spoofData.enabled.level and t:match("[Ll]evel%s*%d+") then
                                desc.Text = t:gsub("%d+", spoofData.level ~= "" and spoofData.level or "%0")
                            end
                        end
                    end
                end
            end)
        end
    end
end)
